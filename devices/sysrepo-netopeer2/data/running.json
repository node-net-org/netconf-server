{
  "ietf-netconf-acm:nacm": {
    "enable-nacm": true,
    "read-default": "permit",
    "write-default": "deny",
    "exec-default": "permit",
    "groups": { "group": [{ "name": "admin", "user-name": ["admin"] }] },
    "rule-list": [
      {
        "name": "admin-all",
        "group": ["admin"],
        "rule": [{ "name": "permit-all", "module-name": "*", "access-operations": "*", "action": "permit" }]
      }
    ]
  }
}
